{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/components/schemas/SubmissionInput",
  "components": {
    "schemas": {
      "SubmissionInput": {
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^1\\.0$",
            "title": "Schema Version"
          },
          "cycle_id": {
            "type": "string",
            "pattern": "^cyc_[A-Za-z0-9_-]{1,80}$",
            "title": "Cycle Id"
          },
          "client_run_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Run Id"
          },
          "data_cutoff": {
            "type": "string",
            "format": "date-time",
            "title": "Data Cutoff"
          },
          "model": {
            "$ref": "#/components/schemas/ModelTrace"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/PredictionInput"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Predictions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "cycle_id",
          "client_run_id",
          "data_cutoff",
          "model",
          "predictions"
        ],
        "title": "SubmissionInput"
      },
      "ModelTrace": {
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Version"
          },
          "trained_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trained At"
          },
          "training_data_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Training Data End"
          },
          "git_commit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "minLength": 7
              },
              {
                "type": "null"
              }
            ],
            "title": "Git Commit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version"
        ],
        "title": "ModelTrace"
      },
      "PredictionInput": {
        "properties": {
          "station_id": {
            "type": "string",
            "pattern": "^[0-9]{5}$",
            "title": "Station Id"
          },
          "target_at": {
            "type": "string",
            "format": "date-time",
            "title": "Target At"
          },
          "value": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station_id",
          "target_at",
          "value"
        ],
        "title": "PredictionInput"
      }
    }
  }
}
